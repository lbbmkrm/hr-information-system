{
    "name": "server",
    "version": "1.0.0",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "prisma generate && tsc -p tsconfig.build.json",
        "start": "node dist/server.js",
        "typecheck": "tsc -p tsconfig.test.json",
        "db:seed": "tsx prisma/seeder.ts",
        "test": "dotenv -e .env.test -- vitest",
        "test:run": "dotenv -e .env.test -- vitest run",
        "test:watch": "dotenv -e .env.test -- vitest",
        "format:check": "prettier --check \"{src,tests,prisma}/**/*.ts\"",
        "format:fix": "prettier --write \"{src,tests,prisma}/**/*.ts\""
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@paralleldrive/cuid2": "^3.3.0",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.2.0",
        "@types/supertest": "^7.2.1",
        "dotenv-cli": "^11.0.0",
        "prettier": "^3.9.6",
        "prisma": "^7.9.1",
        "supertest": "^7.2.2",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    }
}
